---
import Layout from '../layouts/Layout.astro';
import Generator from '../components/Generator';
import * as LucideIcons from 'lucide-react';
const Lucide = (LucideIcons as any).default || LucideIcons;
const { Flame, Star, Layout: LayoutIcon, Zap, Palette } = Lucide;
---

<Layout title="Streak Forge | GitHub Contribution Streak Tracker">
  <main class="relative overflow-hidden">
    {/* Header */}
    <header class="relative z-10 pt-8 pb-4 px-4 flex justify-between items-center max-w-6xl mx-auto">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-indigo-500/20 rounded-xl flex items-center justify-center text-indigo-400 border border-indigo-500/20">
          <Flame size={20} />
        </div>
        <span class="text-xl font-bold text-white tracking-tight">Streak Forge</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://github.com/dyzulk/streak-stats" target="_blank" class="px-4 py-2 bg-slate-900/50 text-slate-300 hover:text-white font-medium rounded-lg border border-slate-800 hover:border-slate-700 transition-all flex items-center gap-2 text-xs backdrop-blur-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          Star on GitHub
        </a>
      </div>
    </header>

    {/* Generator Section (Top) */}
    <div class="relative pt-8 pb-16 px-4">
      <div class="max-w-6xl mx-auto">
        <div id="generator" class="relative group">
          <div class="relative">
            <Generator client:load />
          </div>
        </div>
      </div>
    </div>

    {/* Features Grid */}
    <div class="max-w-6xl mx-auto px-4 py-24 border-t border-slate-900">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="space-y-4">
          <div class="w-12 h-12 bg-indigo-500/10 rounded-2xl flex items-center justify-center text-indigo-400">
            <Zap size={24} />
          </div>
          <h3 class="text-xl font-bold text-white">Blazing Fast</h3>
          <p class="text-slate-500">Powered by Cloudflare Workers at the edge. Negligible latency and global availability.</p>
        </div>
        <div class="space-y-4">
          <div class="w-12 h-12 bg-pink-500/10 rounded-2xl flex items-center justify-center text-pink-400">
            <Palette size={24} />
          </div>
          <h3 class="text-xl font-bold text-white">160+ Themes</h3>
          <p class="text-slate-500">From Dracula to Tokyo Night. Perfect match for any GitHub profile or personal site.</p>
        </div>
        <div class="space-y-4">
          <div class="w-12 h-12 bg-emerald-500/10 rounded-2xl flex items-center justify-center text-emerald-400">
            <Star size={24} />
          </div>
          <h3 class="text-xl font-bold text-white">Highly Flexible</h3>
          <p class="text-slate-500">Daily or weekly modes, custom date formats, and multilingual support for 50+ locales.</p>
        </div>
      </div>
    </div>


  </main>
</Layout>

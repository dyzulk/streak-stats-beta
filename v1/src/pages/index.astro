---
import Layout from '../layouts/Layout.astro';
import Generator from '../components/Generator';
import { Flame, Star, Github, Layout as LayoutIcon, Zap, Palette } from 'lucide-react';
---

<Layout title="Streak Forge | GitHub Contribution Streak Tracker">
  <main class="relative overflow-hidden">
    {/* Hero Section */}
    <div class="relative pt-24 pb-16 px-4">
      <div class="max-w-4xl mx-auto text-center space-y-8">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-sm font-bold uppercase tracking-widest animate-pulse">
          <Flame size={16} />
          v2.0 Beta Live
        </div>
        
        <h1 class="text-6xl md:text-8xl font-extrabold tracking-tight text-white leading-tight">
          Level up your <span class="bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 bg-clip-text text-transparent">GitHub Profile</span>
        </h1>
        
        <p class="text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
          Stunning, edge-optimized streak statistics for your README. Built with TypeScript and Cloudflare, designed for developers who care about aesthetics.
        </p>

        <div class="flex flex-wrap justify-center gap-4 pt-4">
          <a href="#generator" class="px-8 py-4 bg-white text-slate-950 font-bold rounded-2xl hover:bg-slate-200 transition-all hover:scale-105 shadow-xl shadow-white/10">
            Get Started
          </a>
          <a href="https://github.com/dyzulk/streak-stats" target="_blank" class="px-8 py-4 bg-slate-900 text-white font-bold rounded-2xl border border-slate-800 hover:bg-slate-800 transition-all flex items-center gap-2">
            <Github size={20} /> Star on GitHub
          </a>
        </div>
      </div>
    </div>

    {/* Features Grid */}
    <div class="max-w-6xl mx-auto px-4 py-24 border-t border-slate-900">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="space-y-4">
          <div class="w-12 h-12 bg-indigo-500/10 rounded-2xl flex items-center justify-center text-indigo-400">
            <Zap size={24} />
          </div>
          <h3 class="text-xl font-bold text-white">Blazing Fast</h3>
          <p class="text-slate-500">Powered by Cloudflare Workers at the edge. Negligible latency and global availability.</p>
        </div>
        <div class="space-y-4">
          <div class="w-12 h-12 bg-pink-500/10 rounded-2xl flex items-center justify-center text-pink-400">
            <Palette size={24} />
          </div>
          <h3 class="text-xl font-bold text-white">160+ Themes</h3>
          <p class="text-slate-500">From Dracula to Tokyo Night. Perfect match for any GitHub profile or personal site.</p>
        </div>
        <div class="space-y-4">
          <div class="w-12 h-12 bg-emerald-500/10 rounded-2xl flex items-center justify-center text-emerald-400">
            <Star size={24} />
          </div>
          <h3 class="text-xl font-bold text-white">Highly Flexible</h3>
          <p class="text-slate-500">Daily or weekly modes, custom date formats, and multilingual support for 50+ locales.</p>
        </div>
      </div>
    </div>

    {/* Generator Section */}
    <div id="generator" class="py-24 bg-slate-950/50">
      <div class="max-w-6xl mx-auto px-4 mb-12">
        <h2 class="text-4xl font-bold text-white mb-4">Badge Generator</h2>
        <p class="text-slate-500">Customize your badge in real-time. Copy the markdown and paste it into your README.md.</p>
      </div>
      <Generator client:load />
    </div>

    {/* Background Glow */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[500px] bg-indigo-500/20 blur-[120px] rounded-full -z-10 opacity-30"></div>
  </main>
</Layout>

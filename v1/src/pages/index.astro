---
// Home page with interactive demo
import StreakDemo from '@components/StreakDemo';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Streak Forge - GitHub Contribution Streak Tracker</title>
    <meta name="description" content="Track your GitHub contribution streaks with beautiful badges. Powered by Cloudflare." />
    <meta name="theme-color" content="#0969da" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="Streak Forge - GitHub Streak Tracker" />
    <meta property="og:description" content="Beautiful GitHub streak statistics and badges" />
    <meta property="og:type" content="website" />
    
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-size: 16px;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background-color: #ffffff;
        color: #24292f;
        line-height: 1.6;
      }

      main {
        min-height: 100vh;
        padding-bottom: 2rem;
      }

      header {
        background: linear-gradient(135deg, #0969da 0%, #1f6feb 100%);
        color: white;
        padding: 3rem 2rem;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      header h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
      }

      header p {
        font-size: 1.1rem;
        opacity: 0.95;
      }

      footer {
        background-color: #f6f8fa;
        border-top: 1px solid #d0d7de;
        padding: 2rem;
        text-align: center;
        color: #6e7781;
        font-size: 0.9rem;
      }

      footer a {
        color: #0969da;
        text-decoration: none;
      }

      footer a:hover {
        text-decoration: underline;
      }

      @media (max-width: 640px) {
        header {
          padding: 2rem 1rem;
        }

        header h1 {
          font-size: 2rem;
        }

        header p {
          font-size: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <h1>🔥 Streak Forge</h1>
      <p>GitHub Contribution Streak Tracker • Powered by Cloudflare</p>
    </header>

    <main>
      <StreakDemo client:load />
    </main>

    <footer>
      <p>
        Streak Forge &copy; 2024 • Inspired by <a href="https://github.com/DenverCoder1/github-readme-streak-stats" target="_blank">GitHub README Streak Stats</a>
      </p>
      <p>
        <a href="https://github.com" target="_blank">GitHub</a> •
        <a href="https://cloudflare.com" target="_blank">Cloudflare</a>
      </p>
    </footer>
  </body>
</html>

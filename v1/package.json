{
  "name": "streak-forge",
  "version": "1.0.0",
  "description": "GitHub contribution streak statistics and badges - powered by Cloudflare",
  "type": "module",
  "packageManager": "pnpm@>=8.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "github",
    "streak",
    "statistics",
    "badge",
    "contributions",
    "cloudflare"
  ],
  "dependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "latest",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "hono": "latest",
    "lucide-react": "^1.14.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@astrojs/node": "latest",
    "@astrojs/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}

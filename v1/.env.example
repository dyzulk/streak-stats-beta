# GitHub Personal Access Token (Personal Account Token)
# Get one at: https://github.com/settings/tokens
# 
# SCOPES REQUIRED (minimum):
#   - read:user          → Read user profile information
#   - public_repo        → Access public repositories (read-only)
#
# RECOMMENDED (for better functionality):
#   - user:email         → Access email addresses (optional)
#
# SECURITY NOTES:
#   - Only needs READ access (no write/delete permissions)
#   - Never use Fine-grained tokens for this (authentication issues)
#   - Use Classic Personal Access Token
#   - Regenerate token if exposed
#
# RATE LIMITS:
#   - Without token: 60 requests/hour per IP
#   - With token: 5000 requests/hour per user
#
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub API URL (usually doesn't need to change)
GITHUB_API_URL=https://api.github.com

# Cache TTL in seconds (default: 3600 = 1 hour)
# Only applies if using Cloudflare KV
CACHE_TTL=3600
